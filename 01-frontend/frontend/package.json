{
  "name": "spark-workflow-frontend",
  "description": "React frontend for the SPARK Workflow application.",
  "license": "EUPL-1.2",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.30.2"
  },
  "scripts": {
    "build": "vite build && tsc",
    "check": "pnpm run \"/^check:.*/\"",
    "check:lint": "pnpm exec eslint --fix && pnpm exec prettier --write --log-level error .",
    "check:test": "pnpm exec vitest run --reporter=agent",
    "check:types": "pnpm run type-check",
    "dev": "vite",
    "dev:port-forwarding": "node src/scripts/validate-port-forwarding-env.js && VITE_DEV_API_MODE=port-forwarding vite --port 3000",
    "format": "prettier --write .",
    "lint": "pnpm exec eslint --quiet",
    "preview:port-forwarding": "node src/scripts/validate-port-forwarding-env.js && VITE_DEV_API_MODE=port-forwarding vite build && VITE_DEV_API_MODE=port-forwarding vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "serve": "vite preview",
    "test": "vitest run --reporter=dot",
    "test:coverage": "vitest run --coverage && node src/scripts/print-overall-coverage.js",
    "type-check": "tsc --noEmit --incremental",
    "openapi-ts": "openapi-ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.40.0",
    "@tanstack/db": "^0.6.5",
    "@tanstack/query-db-collection": "^1.0.36",
    "@tanstack/react-db": "^0.1.83",
    "@tanstack/react-form": "^1.25.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "diff": "^8.0.3",
    "docx": "^9.5.1",
    "es-toolkit": "^1.45.1",
    "i18next": "^26.3.0",
    "lucide-react": "^0.544.0",
    "react": "19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@hey-api/openapi-ts": "0.97.3",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tanstack/eslint-config": "^0.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "vitest": "^4.1.11",
    "dotenv": "^17.3.1",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.7.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.3.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.16"
  }
}

# .dockerignore

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next

# Production build (will be generated in container)
out
build
dist

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Testing
coverage
.nyc_output
.jest
*.test.js
*.spec.js
__tests__

# Logs
logs
*.log

# Documentation
README.md
docs
*.md

# Kubernetes
k8s
# Ignore YAML files (like k8s configs)
*.yaml
*.yml
# Allow pnpm lock files - they're needed for dependency installation
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Other
.eslintrc*
.prettier*
.editorconfig
.husky

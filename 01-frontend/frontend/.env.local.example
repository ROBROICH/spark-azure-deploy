# Public frontend template. Copy to .env.local and adapt to your backend environment.
# Never add real identities, credentials, or private infrastructure addresses here.
VITE_DEV_API_MODE=port-forwarding
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_BASE_PATH=/app

# Example service addresses. Replace these with your environment's values.
VITE_API_URL=http://localhost:18000
VITE_LAW_CHANGES_OPENAPI_URL=http://localhost:18024/openapi.json
VITE_TEMPORAL_UI_BASE_URL=https://temporal.example.com
VITE_ALLOWED_DOWNLOAD_ORIGINS=https://storage.example.com
VITE_ALLOWED_UPLOAD_ORIGINS=https://storage.example.com

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_ENABLE_EWMS_FEATURE=true
# Product mode: spark (full SPARK Workflow) or ewms (EWMS-only). Defaults to spark.
VITE_PRODUCT_MODE=spark
VITE_ENABLE_AUTH_REDIRECT_RETRY=true
VITE_ENABLE_MAINTENANCE_MODE=false
VITE_SYSTEM_LOAD_DISABLE_THRESHOLD_PERCENTAGE=100
VITE_ENABLE_DOCUMENT_VERSIONING_FEATURE=true
VITE_DANGEROUS_ENABLE_ROLE_SWITCHER=false
ALLOW_DEV_MODE=false

# Required: use the existing identity from your backend environment.
# Do not generate an unrelated UUID. Keep personal values only in .env.local.
VITE_LOCAL_USER_ID=
VITE_LOCAL_USER_EMAIL=
VITE_LOCAL_USER_FIRST_NAME=
VITE_LOCAL_USER_LAST_NAME=

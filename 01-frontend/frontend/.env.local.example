# Frontend runtime defaults
# When running behind a reverse proxy (WEB_HOST set), process-compose injects the public https://<port>-$WEB_HOST values
# (FRONTEND_PUBLIC_URL / S3_PUBLIC_URL / TEMPORAL_UI_PUBLIC_URL from the generated .env), and
# Vite's host check is widened via VITE_DEV_ALLOWED_HOSTS (set it to the proxy's domain suffix, e.g. `.example.com`).
VITE_API_BASE_URL=http://localhost:3000 # For local dev with `pnpm run dev:port-forwarding`
# VITE_API_BASE_URL=/api # For deployed environments with backend mounted to `/api``
VITE_APP_BASE_PATH=/app
VITE_TEMPORAL_UI_BASE_URL=http://localhost:8233
VITE_ALLOWED_DOWNLOAD_ORIGINS=http://localhost:9000
VITE_ALLOWED_UPLOAD_ORIGINS=http://localhost:9000
VITE_SENTRY_DSN=https://<public-key>@<sentry-host>/<project-id>
VITE_SENTRY_ENVIRONMENT=local
VITE_ENABLE_EWMS_FEATURE=true
VITE_ENABLE_AUTH_REDIRECT_RETRY=true
VITE_ENABLE_MAINTENANCE_MODE=false
VITE_SYSTEM_LOAD_DISABLE_THRESHOLD_PERCENTAGE=100
VITE_ENABLE_DOCUMENT_VERSIONING_FEATURE=true
VITE_DANGEROUS_ENABLE_ROLE_SWITCHER=false
ALLOW_DEV_MODE=false

# OpenAPI client generation
# These URLs are also used by Vite to derive local proxy targets for
# `pnpm dev:port-forwarding`, so keep them aligned with your active forwards.
VITE_PLS_OPENAPI_URL=http://localhost:18000/openapi.json
VITE_DMS_OPENAPI_URL=http://localhost:18001/openapi.json
VITE_FCS_OPENAPI_URL=http://localhost:18002/openapi.json
VITE_AOM_OPENAPI_URL=http://localhost:18003/openapi.json
VITE_TEMPORAL_JOBS_OPENAPI_URL=http://localhost:18015/openapi.json
VITE_PNS_OPENAPI_URL=http://localhost:18005/openapi.json
VITE_OMS_OPENAPI_URL=http://localhost:18006/openapi.json
VITE_SUPPLEMENTARY_REQUESTS_OPENAPI_URL=http://localhost:18012/openapi.json
VITE_COMMENTS_OPENAPI_URL=http://localhost:18008/openapi.json
VITE_EXAMINATION_OPENAPI_URL=http://localhost:18009/openapi.json
VITE_VAE_OPENAPI_URL=http://localhost:18010/openapi.json
VITE_LAW_CHANGES_OPENAPI_URL=http://localhost:18024/openapi.json
VITE_IDENTITY_MANAGEMENT_OPENAPI_URL=http://localhost:18013/openapi.json
VITE_FEEDBACK_OPENAPI_URL=http://localhost:18011/openapi.json
VITE_PROTOCOL_OPENAPI_URL=http://localhost:18016/openapi.json

# For use with local development
# With process-compose these are filled from the root .env (LOCAL_USER_*).
# For standalone `pnpm dev:port-forwarding`, copy the values from the root .env.
VITE_LOCAL_USER_ID=12345678-1234-4abc-8abc-123456789abc # replace me
VITE_LOCAL_USER_EMAIL=local-dev@example.test
VITE_LOCAL_USER_FIRST_NAME=Local
VITE_LOCAL_USER_LAST_NAME=Developer

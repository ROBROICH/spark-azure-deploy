# Quelle: das kuratierte Architekturmodell (landscape.toml, views.toml,
# inventory.toml, style.d2);
# der Pfad steht in .agents/config.json unter architectureModelPath.
# architecture-rendered-at: 06.10.2026, 15:51 UTC

# SPARK Workflow — Styleguide der Architekturansichten
#
# Diese Datei wird beim Rendern wörtlich an den Anfang jeder erzeugten Ansicht
# gesetzt. Eine veröffentlichte Ansicht ist dadurch eigenständig: sie lässt sich
# allein mit der d2-CLI erneut rendern, ohne dieses Verzeichnis.
#
# Die Farben stammen aus den Design-Tokens des Frontends
# (01-frontend/frontend/src/styles.css). Sie sind dort als Tailwind-Skalen
# definiert und hier als Hexwerte aufgelöst, weil D2 keine CSS-Variablen kennt.
# Wer einen Token ändert, ändert ihn dort zuerst und trägt ihn hier nach.
#
#   brand      indigo-950 #1e1b4b, brand-800 #31317e   Service-Layer
#   primary    blue-600   #2563eb, blue-50   #eff6ff   Frontend, Datenzugriff
#   ki         violet-800 #5b21b6, violet-50 #f5f3ff   KI-Module und Modelle
#   success    emerald-700 #047857                     Orchestrierung
#   warning    orange-600 #ea580c                      Autorisierung
#   neutral    slate-Skala                             Basis, Kontext, Rahmen
#
# Keine eigene Schriftart: D2 bettet nur mitgelieferte Schriften ein. Inter
# würde --font-regular voraussetzen und die Ansicht von einer Datei abhängig
# machen, die nicht neben der SVG liegt.

vars: {
  d2-config: {
    layout-engine: elk
    # false: diagram grows from the top-left instead of floating in the canvas.
    center: false
    pad: 48
  }
}

classes: {
  # -- Rahmen ---------------------------------------------------------------

  layer: {
    style: {
      stroke: "#cbd5e1"
      stroke-width: 2
      fill: "#ffffff"
      font-size: 24
      bold: true
      font-color: "#334155"
      border-radius: 8
    }
  }

  layer-frontend: {
    style: {
      stroke: "#93c5fd"
      stroke-width: 2
      fill: "#eff6ff"
      font-size: 24
      bold: true
      font-color: "#1e3a8a"
      border-radius: 8
    }
  }

  layer-service: {
    style: {
      stroke: "#a5b4fc"
      stroke-width: 2
      fill: "#eef2ff"
      font-size: 24
      bold: true
      font-color: "#1e1b4b"
      border-radius: 8
    }
  }

  layer-orchestration: {
    style: {
      stroke: "#6ee7b7"
      stroke-width: 2
      fill: "#ecfdf5"
      font-size: 24
      bold: true
      font-color: "#064e3b"
      border-radius: 8
    }
  }

  layer-ai: {
    style: {
      stroke: "#c4b5fd"
      stroke-width: 2
      fill: "#f5f3ff"
      font-size: 24
      bold: true
      font-color: "#4c1d95"
      border-radius: 8
    }
  }

  layer-basis: {
    style: {
      stroke: "#cbd5e1"
      stroke-width: 2
      fill: "#f1f5f9"
      font-size: 24
      bold: true
      font-color: "#334155"
      border-radius: 8
    }
  }

  layer-infrastructure: {
    style: {
      stroke: "#94a3b8"
      stroke-width: 2
      stroke-dash: 4
      fill: "#f8fafc"
      font-size: 24
      bold: true
      font-color: "#475569"
      border-radius: 8
    }
  }

  # Durchgezogen: eine Gruppe liegt im Repository, gestrichelt bleibt dem
  # vorbehalten, was nicht aus ihm deployt wird.
  group: {
    style: {
      stroke: "#cbd5e1"
      stroke-width: 1
      fill: "#f8fafc"
      font-size: 19
      bold: true
      font-color: "#475569"
      border-radius: 6
    }
  }

  legend: {
    style: {
      stroke: "#cbd5e1"
      stroke-width: 2
      fill: "#ffffff"
      font-size: 19
      bold: true
      font-color: "#334155"
      border-radius: 8
    }
  }

  # Textspalte der Legende neben den Symbolen: ohne eigenen Rahmen.
  legend-column: {
    style: {
      stroke: transparent
      fill: transparent
    }
  }

  # Unsichtbare Endpunkte einer Musterkante in der Legende; sichtbar ist nur
  # die Linie selbst.
  legend-anchor: {
    width: 4
    height: 4
    style: {
      stroke: transparent
      fill: transparent
    }
  }

  # Beschriftung einer Musterkante, rechts neben der Linie.
  legend-label: {
    shape: text
    style: {
      font-size: 15
      font-color: "#334155"
    }
  }

  # -- Systemkontext --------------------------------------------------------

  actor: {
    style: {
      stroke: "#334155"
      stroke-width: 2
      fill: "#f1f5f9"
      font-color: "#0f172a"
      font-size: 16
      border-radius: 6
    }
  }

  actor-indirect: {
    style: {
      stroke: "#94a3b8"
      stroke-width: 2
      stroke-dash: 3
      fill: "#f8fafc"
      font-color: "#475569"
      font-size: 16
      border-radius: 6
    }
  }

  system: {
    style: {
      stroke: "#1e1b4b"
      stroke-width: 2
      fill: "#31317e"
      font-color: "#ffffff"
      font-size: 19
      bold: true
      border-radius: 8
      shadow: true
    }
  }

  external: {
    style: {
      stroke: "#64748b"
      stroke-dash: 3
      fill: "#f1f5f9"
      font-color: "#334155"
      font-size: 16
      border-radius: 6
    }
  }

  # -- Container ------------------------------------------------------------

  frontend: {
    style: {
      stroke: "#2563eb"
      stroke-width: 2
      fill: "#eff6ff"
      font-color: "#1e3a8a"
      font-size: 16
      border-radius: 6
    }
  }

  service: {
    style: {
      stroke: "#31317e"
      stroke-width: 2
      fill: "#eef2ff"
      font-color: "#1e1b4b"
      font-size: 16
      border-radius: 6
    }
  }

  # Ein Pool ist eine Instanz des geteilten SPARK-Backend-Images. Die dunklere
  # Füllung trennt ihn optisch von den eigenständigen Diensten desselben Layers.
  pool: {
    style: {
      stroke: "#31317e"
      stroke-width: 2
      fill: "#e0e7ff"
      font-color: "#1e1b4b"
      font-size: 16
      border-radius: 6
    }
  }

  modulith: {
    style: {
      stroke: "#1e1b4b"
      stroke-width: 3
      fill: "#c7d2fe"
      font-color: "#1e1b4b"
      font-size: 16
      bold: true
      border-radius: 6
    }
  }

  orchestration: {
    style: {
      stroke: "#047857"
      stroke-width: 2
      fill: "#ecfdf5"
      font-color: "#064e3b"
      font-size: 16
      border-radius: 6
    }
  }

  ai-module: {
    style: {
      stroke: "#5b21b6"
      stroke-width: 2
      fill: "#f5f3ff"
      font-color: "#4c1d95"
      font-size: 16
      border-radius: 6
    }
  }

  ai-infrastructure: {
    style: {
      stroke: "#7c3aed"
      stroke-width: 2
      fill: "#ede9fe"
      font-color: "#4c1d95"
      font-size: 16
      border-radius: 6
    }
  }

  platform: {
    style: {
      stroke: "#475569"
      stroke-width: 2
      fill: "#f8fafc"
      font-color: "#1e293b"
      font-size: 16
      border-radius: 6
    }
  }

  # -- Komponenten ----------------------------------------------------------

  component: {
    style: {
      stroke: "#31317e"
      stroke-width: 1
      fill: "#eef2ff"
      font-color: "#1e1b4b"
      font-size: 15
      border-radius: 4
    }
  }

  # -- Betreiberseitig ------------------------------------------------------
  #
  # Gestrichelte Knoten und Rahmen heißen: nicht aus diesem Repository
  # deployt (betreiberseitig, extern, Sprachmodelle, Beteiligte ohne
  # Systemzugang). Bei Kanten unterscheidet die Strichelung dagegen den Typ.

  infrastructure: {
    style: {
      stroke: "#64748b"
      stroke-width: 2
      stroke-dash: 4
      fill: "#f1f5f9"
      font-color: "#334155"
      font-size: 16
      border-radius: 6
    }
  }

  language-model: {
    style: {
      stroke: "#7c3aed"
      stroke-width: 2
      stroke-dash: 4
      fill: "#faf5ff"
      font-color: "#4c1d95"
      font-size: 15
      border-radius: 6
    }
  }

  # -- Kantentypen ----------------------------------------------------------
  #
  # Das Vokabular ist in landscape.toml unter [relation_types] festgelegt.
  # Die Farben sind so gewählt, dass je zwei Typen mit gleicher Strichart auch
  # bei Rot-Grün-Sehschwäche unterscheidbar bleiben; wer eine Farbe ändert,
  # prüft das erneut (Farbabstand, nicht Augenmaß).

  http: {
    style: {
      stroke: "#475569"
      stroke-width: 2
      font-size: 14
      font-color: "#475569"
    }
  }

  http-primary: {
    style: {
      stroke: "#1e293b"
      stroke-width: 3
      font-size: 14
      font-color: "#0f172a"
      bold: true
    }
  }

  queue: {
    style: {
      stroke: "#047857"
      stroke-width: 2
      font-size: 14
      font-color: "#047857"
    }
  }

  datastore: {
    style: {
      stroke: "#2563eb"
      stroke-width: 2
      font-size: 14
      font-color: "#1e3a8a"
    }
  }

  objectstore: {
    style: {
      stroke: "#2563eb"
      stroke-width: 2
      stroke-dash: 3
      font-size: 14
      font-color: "#1e3a8a"
    }
  }

  cache: {
    style: {
      stroke: "#60a5fa"
      stroke-width: 2
      font-size: 14
      font-color: "#1e3a8a"
    }
  }

  authz: {
    style: {
      stroke: "#ea580c"
      stroke-width: 2
      font-size: 14
      font-color: "#9a3412"
    }
  }

  llm: {
    style: {
      stroke: "#5b21b6"
      stroke-width: 2
      font-size: 14
      font-color: "#5b21b6"
    }
  }

  uses: {
    style: {
      stroke: "#31317e"
      stroke-width: 2
      font-size: 14
      font-color: "#31317e"
    }
  }

  # Beteiligung ohne Systemzugang: die Unterlagen erreichen das System, die
  # Person selbst meldet sich nie an.
  uses-indirect: {
    style: {
      stroke: "#94a3b8"
      stroke-width: 2
      stroke-dash: 4
      font-size: 14
      font-color: "#64748b"
    }
  }

  # -- Hinweistext unterhalb einer Ansicht ----------------------------------

  note: {
    style: {
      font-size: 15
      font-color: "#475569"
    }
  }

  diagram-meta: {
    style: {
      font-size: 15
      font-color: "#334155"
      bold: true
    }
  }
}

direction: down
grid-columns: 1
grid-gap: 32

title: |md
  # C2 KI-Verarbeitung

  KI-Module, Modellzugang, Vorverarbeitung und die Dienste, die sie aufrufen
| {
  near: top-center
  style: { font-size: 24; font-color: "#1e1b4b" }
}

graph: "Laufzeitbeziehungen" {
  class: group
  direction: right

  ai-module-layer: "AI Module Layer" {
    class: layer-ai
    ki-module: "KI-Module" {
      class: group
      inhaltsextraktion: "Inhaltsextraktion\nPython, Temporal-Worker" { class: ai-module }
      formale-vollstaendigkeitspruefung: "Formale Vollstaendigkeitspruefung\nPython, Temporal-Worker" { class: ai-module }
      plausibilitaetspruefung: "Plausibilitaetspruefung\nPython, Temporal-Worker" { class: ai-module }
      materielle-vollstaendigkeitspruefung: "Materielle Vollstaendigkeitspruefung\nPython, Temporal-Worker" { class: ai-module }
      einwendungsmanagement: "Einwendungsmanagement\nPython, Temporal-Worker" { class: ai-module }
      rechtliche-pruefung-und-bewertung: "Rechtliche Pruefung und Bewertung\nPython, Temporal-Worker" { class: ai-module }
      rechtsmethodik: "Rechtsmethodik\nPython, Temporal-Worker" { class: ai-module }
      anonymisierung: "Anonymisierung\nPython, Temporal-Worker" { class: ai-module }
      risikohinweiser: "Risikohinweiser\nPython, Temporal-Worker" { class: ai-module }
    }
  }

  orchestration-layer: "Orchestration Layer" {
    class: layer-orchestration
    workflow-engine: "Workflow Engine" {
      class: group
      temporal: "Temporal\nTemporal" { class: orchestration }
    }
  }

  plattformdienste: "Plattformdienste" {
    class: group
    spicedb: "SpiceDB\nSpiceDB" { class: platform }
    qdrant: "Qdrant\nQdrant" { class: platform }
    unoserver: "Unoserver\nUnoserver, LibreOffice" { class: platform }
    clamav: "ClamAV\nClamAV, clamav-api (REST)" { class: platform }
    docling-rq: "Docling\nDocling, RQ" { class: platform }
  }

  datenbankdienste: "Datenbankdienste" {
    class: group
    gesetze-normen-db-service: "Gesetz- und Normendatenbankdienst\nPython, FastAPI, Temporal" { class: service }
    jura-db-service: "Juristischer Datenbankdienst\nPython, FastAPI, Temporal" { class: service }
    gesetzesbegruendung-db-service: "Gesetzesbegruendungsdatenbankdienst\nPython, FastAPI, Temporal" { class: service }
  }

  document-management-service: "Dokumentenmanagement\nWorker document-management" { class: pool }

  formal-completeness-check: "Formale Vollstaendigkeitspruefung" { class: pool }

  temporal-job-service: "Workflowmanagement\nWorker temporal-job" { class: pool }

  llm-client: "LLM-Client\nPython, Temporal-Worker" { class: platform }

  kontext-infrastructure: "Betreiberseitig bereitgestellt" {
    class: layer-infrastructure
    postgresql: "PostgreSQL" { class: infrastructure }
    identity-provider: "Identitaets- und Autorisierungsdienst" { class: infrastructure }
    llm-proxy: "LLM-Proxy" { class: infrastructure }
  }

  datenbankdienste.gesetzesbegruendung-db-service -> datenbankdienste.gesetze-normen-db-service: "Normenbezug" { class: http }
  ai-module-layer.ki-module -> orchestration-layer.workflow-engine.temporal: "Task Queue (alle 9 KI-Module)" { class: queue }
  ai-module-layer.ki-module.inhaltsextraktion -> document-management-service: "Dokumente lesen" { class: http }
  ai-module-layer.ki-module.formale-vollstaendigkeitspruefung -> document-management-service: "Dokumente lesen" { class: http }
  ai-module-layer.ki-module.plausibilitaetspruefung -> document-management-service: "Dokumente lesen" { class: http }
  ai-module-layer.ki-module.inhaltsextraktion -> plattformdienste.docling-rq: "Layoutanalyse" { class: http }
  ai-module-layer.ki-module.inhaltsextraktion -> plattformdienste.unoserver: "Dokumentkonvertierung" { class: http }
  ai-module-layer.ki-module.inhaltsextraktion -> plattformdienste.qdrant: "Vektoren schreiben" { class: datastore }
  ai-module-layer.ki-module.inhaltsextraktion -> kontext-infrastructure.identity-provider: "Dienst-Token" { class: http }
  ai-module-layer.ki-module.plausibilitaetspruefung -> plattformdienste.qdrant: "Vektoren schreiben und suchen" { class: datastore }
  ai-module-layer.ki-module.materielle-vollstaendigkeitspruefung -> formal-completeness-check: "Pruefbefunde" { class: http }
  ai-module-layer.ki-module.materielle-vollstaendigkeitspruefung -> datenbankdienste.jura-db-service: "Urteilstexte" { class: http }
  ai-module-layer.ki-module.rechtsmethodik -> datenbankdienste.jura-db-service: "Urteilstexte" { class: http }
  ai-module-layer.ki-module.materielle-vollstaendigkeitspruefung -> datenbankdienste.gesetzesbegruendung-db-service: "Gesetzesbegruendungen" { class: http }
  ai-module-layer.ki-module.rechtsmethodik -> datenbankdienste.gesetzesbegruendung-db-service: "Gesetzesbegruendungen" { class: http }
  ai-module-layer.ki-module.materielle-vollstaendigkeitspruefung -> plattformdienste.qdrant: "Vektorsuche" { class: datastore }
  ai-module-layer.ki-module.rechtsmethodik -> datenbankdienste.gesetze-normen-db-service: "Normen und Absaetze" { class: http }
  ai-module-layer.ki-module -> temporal-job-service: "Workflow-Status melden (alle 9 KI-Module)" { class: http }
  datenbankdienste.gesetze-normen-db-service -> temporal-job-service: "Workflow-Status melden" { class: http }
  datenbankdienste.jura-db-service -> temporal-job-service: "Workflow-Status melden" { class: http }
  ai-module-layer.ki-module -> llm-client: "Modellaufrufe (alle 9 KI-Module)" { class: queue }
  datenbankdienste.gesetze-normen-db-service -> kontext-infrastructure.postgresql: "Gesetze und Normen" { class: datastore }
  datenbankdienste.jura-db-service -> kontext-infrastructure.postgresql: "Gerichtsentscheidungen" { class: datastore }
  datenbankdienste.gesetzesbegruendung-db-service -> kontext-infrastructure.postgresql: "Gesetzesbegruendungen" { class: datastore }
  datenbankdienste -> orchestration-layer.workflow-engine.temporal: "Datenuebernahme (alle 3 Datenbankdienste)" { class: queue }
  datenbankdienste.jura-db-service -> kontext-infrastructure.llm-proxy: "Embeddings" { class: llm }
  datenbankdienste.gesetzesbegruendung-db-service -> kontext-infrastructure.llm-proxy: "Embeddings" { class: llm }
  datenbankdienste.gesetzesbegruendung-db-service -> plattformdienste.docling-rq: "Dokumentkonvertierung" { class: http }
  datenbankdienste.gesetzesbegruendung-db-service -> kontext-infrastructure.identity-provider: "Dienst-Token fuer Docling" { class: http }
  datenbankdienste -> kontext-infrastructure.identity-provider: "Token-Pruefung (alle 3 Datenbankdienste)" { class: http }
  orchestration-layer.workflow-engine.temporal -> kontext-infrastructure.postgresql: "Workflow-Persistenz" { class: datastore }
  plattformdienste.spicedb -> kontext-infrastructure.postgresql: "Relationen" { class: datastore }
  llm-client -> kontext-infrastructure.llm-proxy: "Modellaufrufe" { class: llm }
  llm-client -> orchestration-layer.workflow-engine.temporal: "Task Queues" { class: queue }
}


dokumentation: "Legende und Metadaten" {
  class: legend
  grid-columns: 3
  grid-gap: 32
  legende-symbole: "Symbole" {
    class: legend
    grid-columns: 3
    grid-gap: 32
    l-pool: "Backend-Pool" { class: pool }
    l-modulith: "SPARK Backend (Modulith)" { class: modulith }
    l-service: "Eigenstaendiger Dienst" { class: service }
    l-ai: "KI-Modul" { class: ai-module }
    l-platform: "Plattformdienst" { class: platform }
    l-infra: "Betreiberseitig bereitgestellt" { class: infrastructure }
  }

  legende-text: "" {
    class: legend-column
    grid-columns: 1
    legende-kanten: "Kantentypen (Laufzeit)" {
      class: legend-column
      grid-rows: 4
      grid-columns: 3
      horizontal-gap: 72
      vertical-gap: 16
      von-datastore: "" { class: legend-anchor }
      nach-datastore: "" { class: legend-anchor }
      text-datastore: "Zugriff auf eine relationale oder Vektordatenbank" { class: legend-label }
      von-http: "" { class: legend-anchor }
      nach-http: "" { class: legend-anchor }
      text-http: "Synchroner Aufruf ueber HTTP" { class: legend-label }
      von-llm: "" { class: legend-anchor }
      nach-llm: "" { class: legend-anchor }
      text-llm: "Aufruf eines Sprachmodells ueber den LLM-Proxy" { class: legend-label }
      von-queue: "" { class: legend-anchor }
      nach-queue: "" { class: legend-anchor }
      text-queue: "Asynchrone Uebergabe ueber Temporal oder RQ" { class: legend-label }
      von-datastore -> nach-datastore: { class: datastore }
      von-http -> nach-http: { class: http }
      von-llm -> nach-llm: { class: llm }
      von-queue -> nach-queue: { class: queue }
    }

    metadaten: |md
      **Erstellt am** 06.10.2026, 15:51 UTC\
      **Ansicht** c2-ai (C2, Fokus)\
      **Renderer** d2 v0.8.2\
      **Quelle** kuratiertes Modell\
      landscape.toml, views.toml, inventory.toml
    | {
      class: diagram-meta
    }

  }
  hinweis: |md
    Ausschnitt der C2-Karte mit 62 hier gezeichneten\
    Laufzeitbeziehungen von insgesamt 78 im Inventar.

    Fette HTTP-Kanten beruehren spark-backend. Jede Kante ist einzeln\
    bestaetigt; der Beleg steht in inventory.toml.

    Gemeinsame Kanten aller Module einer Gruppe, je vom Gruppenrahmen gezeichnet:
    - alle 9 KI-Module: 'Task Queue' zu temporal
    - alle 9 KI-Module: 'Workflow-Status melden' zu temporal-job-service
    - alle 9 KI-Module: 'Modellaufrufe' zu llm-client
    - alle 3 Datenbankdienste: 'Datenuebernahme' zu temporal
    - alle 3 Datenbankdienste: 'Token-Pruefung' zu identity-provider
  | {
    class: note
  }

}

// SPARK app-tier on Azure Container Apps (no-refactor lift-and-shift).
// Deploys backend HTTP services + db-services + llm-client + AI module workers.
// Env vars are the process-compose values with localhost:PORT rewritten to ACA internal DNS
// (HTTP services are reachable at http://<app-name>; infra at host:port over TCP ingress).
// Secrets come from Key Vault (passed as secure params); ACR pull via admin creds (listCredentials).
// Frontend + identity-management/keycloak are deployed separately.
param location string = resourceGroup().location
param environmentName string = 'cae-spark-demo'
param acrName string = 'acrsparkdemo'
param acrResourceGroup string = resourceGroup().name
param imageTag string = '0.2'

@description('Public image registry prefix (e.g. ghcr.io/owner). When set, pull public images from here instead of the ACR (no registry auth). Empty = use the ACR.')
param imageRegistry string = ''

// OpenAI-compatible LLM endpoint + models. Point at OpenAI (https://api.openai.com/v1)
// or Azure OpenAI (https://<resource>.openai.azure.com/openai/v1/) at deploy time;
// deploy-app-services.ps1 passes these from the SPARK_* env vars.
param litellmBaseUrl string = 'https://api.openai.com/v1'
param litellmTextModel string = 'gpt-5.4-mini'
param litellmEmbeddingModel string = 'text-embedding-3-small'

@secure()
param dbPassword string
@secure()
param s3AccessKey string
@secure()
param s3SecretKey string
@secure()
param openaiApiKey string
@secure()
param spiceDbToken string
@secure()
param keycloakClientSecret string

resource env 'Microsoft.App/managedEnvironments@2023-05-01' existing = { name: environmentName }

// Image source: a public registry (imageRegistry, e.g. ghcr.io/owner) when set,
// otherwise the private ACR via admin creds. Public GHCR needs no registry auth.
var useAcr = empty(imageRegistry)
resource acr 'Microsoft.ContainerRegistry/registries@2023-07-01' existing = if (useAcr) {
  name: acrName
  scope: resourceGroup(acrResourceGroup)
}

var registryServer = useAcr ? acr!.properties.loginServer : imageRegistry

var registries = useAcr ? [
  {
    server: acr!.properties.loginServer
    username: acr!.listCredentials().username
    passwordSecretRef: 'acr-pw'
  }
] : []

var baseSecrets = [
  { name: 'db-password', value: dbPassword }
  { name: 's3-access-key', value: s3AccessKey }
  { name: 's3-secret-key', value: s3SecretKey }
  { name: 'openai-api-key', value: openaiApiKey }
  { name: 'spicedb-token', value: spiceDbToken }
  { name: 'keycloak-client-secret', value: keycloakClientSecret }
]
var commonSecrets = useAcr ? concat(baseSecrets, [
  { name: 'acr-pw', value: acr!.listCredentials().passwords[0].value }
]) : baseSecrets

// Full per-service env (generated by scripts/azure/gen-app-env.py from .env.local + process-compose,
// with localhost:PORT rewritten to ACA internal DNS and secrets marked as secretRef).
var appEnv = loadJsonContent('app-env.json')

// ---- Shared env fragments (localhost -> ACA internal DNS) ----
var commonEnv = [
  { name: 'ENV', value: 'dev' }
  { name: 'AUTH_MODE', value: 'disabled' }
  { name: 'PYTHONUNBUFFERED', value: '1' }
  { name: 'PYTHONUTF8', value: '1' }
  { name: 'PYTHONIOENCODING', value: 'utf-8' }
  { name: 'DB_USER', value: 'postgres' }
  { name: 'DB_PASSWORD', secretRef: 'db-password' }
  { name: 'DB_HOST', value: 'postgresql' }
  { name: 'DB_PORT', value: '5432' }
  { name: 'TEMPORAL_JOB_SERVICE_URL', value: 'http://temporal-job' }
  { name: 'TEMPORAL_HOST', value: 'temporal:7233' }
  { name: 'TEMPORAL_SERVER_URL', value: 'temporal:7233' }
  { name: 'TEMPORAL_ADDRESS', value: 'temporal:7233' }
  { name: 'TEMPORAL_NAMESPACE', value: 'default' }
  { name: 'TEMPORAL_S3_BUCKET_NAME', value: 'temporal-payloads' }
  { name: 'TEMPORAL_S3_ENDPOINT_URL', value: 'http://minio:9000' }
  { name: 'TEMPORAL_S3_ACCESS_KEY_ID', secretRef: 's3-access-key' }
  { name: 'TEMPORAL_S3_SECRET_ACCESS_KEY', secretRef: 's3-secret-key' }
  { name: 'TEMPORAL_S3_REGION', value: 'eu-west-1' }
  { name: 'QUARANTINE_S3_ACCESS_KEY_ID', secretRef: 's3-access-key' }
  { name: 'QUARANTINE_S3_SECRET_ACCESS_KEY', secretRef: 's3-secret-key' }
]

// TEMPORAL__ (pydantic nested) block used by services that start Temporal workers/clients
var temporalNsEnv = [
  { name: 'TEMPORAL__HOST', value: 'temporal:7233' }
  { name: 'TEMPORAL__NAMESPACE', value: 'default' }
  { name: 'TEMPORAL__S3_BUCKET_NAME', value: 'temporal-payloads' }
  { name: 'TEMPORAL__S3_ENDPOINT_URL', value: 'http://minio:9000' }
  { name: 'TEMPORAL__S3_ACCESS_KEY_ID', secretRef: 's3-access-key' }
  { name: 'TEMPORAL__S3_SECRET_ACCESS_KEY', secretRef: 's3-secret-key' }
  { name: 'TEMPORAL__S3_REGION', value: 'eu-west-1' }
]

// LiteLLM-compatible embedding config for the db-services (calls external OpenAI)
var chunkingEnv = [
  { name: 'CHUNKING_PROVIDER', value: 'litellm' }
  { name: 'CHUNKING_MODEL', value: litellmEmbeddingModel }
  { name: 'CHUNKING_URL', value: litellmBaseUrl }
  { name: 'CHUNKING_APIKEY', secretRef: 'openai-api-key' }
]

// ---- HTTP services (internal ingress, container port 8000) ----
var httpServices = [
  {
    name: 'project-logic'
    image: 'project-logic-service'
    env: concat(commonEnv, temporalNsEnv, [
      { name: 'DB_NAME', value: 'project_logic' }
      { name: 'TEMPORAL__TASK_QUEUE', value: 'project-logic-service' }
      { name: 'API__ADMINISTRATIVE_FILE_DRAFT_BASE_URL', value: 'http://administrative-file-draft' }
    ])
  }
  {
    name: 'document-management'
    image: 'document-management-service'
    env: concat(commonEnv, temporalNsEnv, [
      { name: 'DB_NAME', value: 'dms' }
      { name: 'TEMPORAL__TASK_QUEUE', value: 'dms' }
      { name: 'TEMPORAL__PLS_TASK_QUEUE', value: 'project-logic-service' }
      { name: 'TEMPORAL__ENABLE_APPROVAL', value: 'false' }
    ])
  }
  {
    name: 'formal-completeness'
    image: 'formal-completeness-check'
    env: concat(commonEnv, [
      { name: 'DB_NAME', value: 'formal_completeness_check' }
      { name: 'DOCUMENT_MANAGEMENT_SERVICE_URL', value: 'http://document-management' }
      { name: 'PROJECT_LOGIC_SERVICE_URL', value: 'http://project-logic' }
    ])
  }
  {
    name: 'agent-orchestration'
    image: 'agent-orchestration-service'
    env: concat(commonEnv, temporalNsEnv, [
      { name: 'TEMPORAL__TASK_QUEUE', value: 'fvp-task-queue' }
      { name: 'API__PLS_BASE_URL', value: 'http://project-logic' }
      { name: 'API__DMS_BASE_URL', value: 'http://document-management' }
      { name: 'API__FVP_BASE_URL', value: 'http://formal-completeness' }
      { name: 'API__DIPLAN_BASE_URL', value: 'http://diplan' }
      { name: 'API__PLAUSIBILITY_NOTES_BASE_URL', value: 'http://plausibility-notes' }
      { name: 'API__OBJECTIONS_SERVICE_BASE_URL', value: 'http://objections-management' }
      { name: 'API__FPP_BASE_URL', value: 'http://fpp' }
      { name: 'API__EXAMINATION_SERVICE_BASE_URL', value: 'http://examination' }
      { name: 'API__ADMINISTRATIVE_FILE_DRAFT_BASE_URL', value: 'http://administrative-file-draft' }
    ])
  }
  {
    name: 'plausibility-notes'
    image: 'plausibility-notes'
    env: concat(commonEnv, [
      { name: 'DB_NAME', value: 'plausibility_notes' }
      { name: 'DOCUMENT_MANAGEMENT_SERVICE_URL', value: 'http://document-management' }
    ])
  }
  {
    name: 'objections-management'
    image: 'objections-management-service'
    env: concat(commonEnv, [ { name: 'DB_NAME', value: 'objections_db' } ])
  }
  {
    name: 'fpp'
    image: 'fpp-service'
    env: concat(commonEnv, [
      { name: 'DB_NAME', value: 'fpp' }
      { name: 'PROJECT_LOGIC_SERVICE_URL', value: 'http://project-logic' }
      { name: 'AGENT_ORCHESTRATION_BASE_URL', value: 'http://agent-orchestration' }
    ])
  }
  {
    name: 'comment'
    image: 'comment-service'
    env: concat(commonEnv, [ { name: 'DB_NAME', value: 'comment_service_db' } ])
  }
  {
    name: 'examination'
    image: 'examination-service'
    env: concat(commonEnv, [ { name: 'DB_NAME', value: 'examination_service_db' } ])
  }
  {
    name: 'administrative-file-draft'
    image: 'administrative-file-draft'
    env: concat(commonEnv, [ { name: 'DB_NAME', value: 'administrative_file_draft' } ])
  }
  {
    name: 'feedback'
    image: 'feedback-service'
    env: concat(commonEnv, [ { name: 'DB_NAME', value: 'feedback_db' } ])
  }
  {
    name: 'supplementary-requests'
    image: 'supplementary-requests-service'
    env: concat(commonEnv, [ { name: 'DB_NAME', value: 'supplementary_requests' } ])
  }
  {
    name: 'temporal-job'
    image: 'temporal-job-service'
    env: concat(commonEnv, temporalNsEnv, [
      { name: 'DB__USER', value: 'postgres' }
      { name: 'DB__PASSWORD', secretRef: 'db-password' }
      { name: 'DB__HOST', value: 'postgresql' }
      { name: 'DB__PORT', value: '5432' }
      { name: 'DB__NAME', value: 'temporal_job_service_db' }
      { name: 'TEMPORAL__TASK_QUEUE', value: 'temporal-job-service' }
      { name: 'TEMPORAL__S3_ARCHIVAL_BUCKET_NAME', value: 'temporal-payloads' }
    ])
  }
  {
    name: 'protocol'
    image: 'protocol-service'
    env: concat(commonEnv, [
      { name: 'PROJECT_LOGIC_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'FORMAL_COMPLETENESS_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'COMMENT_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'SUPPLEMENTARY_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'PLAUSIBILITY_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'DOCUMENT_MANAGEMENT_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'ADMINISTRATIVE_DRAFT_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'EXAMINATION_DB_PASSWORD', secretRef: 'db-password' }
      { name: 'OBJECTIONS_MANAGEMENT_DB_PASSWORD', secretRef: 'db-password' }
    ])
  }
  {
    name: 'gesetze-normen-db'
    image: 'gesetze-normen-db-service'
    env: concat(commonEnv, [
      { name: 'DB_NAME', value: 'gesetze-normen' }
      { name: 'LOG_LEVEL', value: 'DEBUG' }
    ])
  }
  {
    name: 'gesetzesbegruendung-db'
    image: 'gesetzesbegruendung-db-service'
    env: concat(commonEnv, chunkingEnv, [
      { name: 'DB_NAME', value: 'begruendungen-db' }
      { name: 'GESETZE_NORMEN_URL', value: 'http://gesetze-normen-db' }
      { name: 'LOG_LEVEL', value: 'DEBUG' }
    ])
  }
  {
    name: 'jura-db'
    image: 'jura-db-service'
    env: concat(commonEnv, chunkingEnv, [
      { name: 'DB_NAME', value: 'jura-db' }
      { name: 'GESETZE_NORMEN_URL', value: 'http://gesetze-normen-db' }
      { name: 'LOG_LEVEL', value: 'INFO' }
    ])
  }
  {
    name: 'identity-management'
    image: 'identity-management-service'
    env: []
  }
]

// ---- Temporal workers (no ingress; image default CMD runs the worker) ----
var workers = [
  {
    name: 'llm-client'
    image: 'llm-client'
    env: concat(commonEnv, [
      { name: 'LITELLM_BASE_URL', value: litellmBaseUrl }
      { name: 'LITELLM_TEXT_MODEL', value: litellmTextModel }
      { name: 'LITELLM_EMBEDDING_MODEL', value: litellmEmbeddingModel }
      { name: 'LITELLM_MASTER_KEY', secretRef: 'openai-api-key' }
      { name: 'LITELLM_DISK_CACHE_DIR', value: '/tmp/spark-workflow-llm-cache' }
    ])
  }
  {
    name: 'worker-formale-pruefung'
    image: 'modul-formale-pruefung'
    env: concat(commonEnv, [
      { name: 'DMS_BASE_URL', value: 'http://document-management' }
      { name: 'LITELLM_MODEL', value: litellmTextModel }
      { name: 'OTEL_SERVICE_NAME', value: 'formale-pruefung-worker' }
    ])
  }
  {
    name: 'worker-risikohinweiser'
    image: 'modul-risikohinweiser'
    env: concat(commonEnv, [
      { name: 'LITELLM_MODEL', value: litellmTextModel }
      { name: 'OTEL_SERVICE_NAME', value: 'risikohinweiser' }
      { name: 'TEMPORAL_LLM_MAX_PER_SECOND', value: '3' }
    ])
  }
  {
    name: 'worker-inhaltsextraktion'
    image: 'modul-inhaltsextraktion'
    env: concat(commonEnv, [
      { name: 'DMS_BASE_URL', value: 'http://document-management' }
      { name: 'QDRANT_BASE_URL', value: 'http://qdrant:6333' }
      { name: 'INJECTION_LLM_SCAN_ENABLED', value: 'false' }
      { name: 'INJECTION_MODEL_URL', value: 'http://document-management' }
    ])
  }
  {
    name: 'worker-rechtsmethodik'
    image: 'modul-rechtsmethodik'
    env: concat(commonEnv, [
      { name: 'LEGAL_DEFINITION_POSTGRES_HOST', value: 'postgresql' }
      { name: 'LEGAL_DEFINITION_POSTGRES_PORT', value: '5432' }
      { name: 'LAW_DATABASE_DOCUMENTS_URL', value: 'http://gesetze-normen-db/documents/' }
      { name: 'LAW_DATABASE_NORMS_SEARCH_URL', value: 'http://gesetze-normen-db/norms/search' }
      { name: 'LAW_DATABASE_ABSATZ_JURABK_URL', value: 'http://gesetze-normen-db/absatz/{jurabk}' }
      { name: 'LAW_DATABASE_DOCUMENTS_SEARCH_TERM_URL', value: 'http://gesetze-normen-db/documents/search/{search_term}' }
      { name: 'LAW_DATABASE_DOCUMENTS_JURABK_URL', value: 'http://gesetze-normen-db/documents/{jurabk}' }
      { name: 'LAW_DATABASE_LEGALDEFINITIONEN_JURABK_URL', value: 'http://gesetze-normen-db/legaldefinitionen/{jurabk}' }
      { name: 'LAW_DATABASE_TECHNISCHE_NORMEN_DOKUMENT_URL', value: 'http://gesetze-normen-db/technische-normen/{dokument}' }
      { name: 'LAW_DATABASE_QUERY_TOP_K_DR_URL', value: 'http://gesetzesbegruendung-db/query_top_k' }
      { name: 'LAW_DATABASE_QUERY_K_RESULTS_UT_URL', value: 'http://jura-db/query_k_results' }
      { name: 'LAW_DATABASE_QUERY_CHUNKS_UT_URL', value: 'http://jura-db/chunks' }
    ])
  }
  {
    name: 'worker-bewertung'
    image: 'modul-bewertung'
    env: concat(commonEnv, [ { name: 'OTEL_SERVICE_NAME', value: 'bewertung-worker' } ])
  }
  {
    name: 'worker-einwendungsmanagement'
    image: 'modul-einwendungsmanagement'
    env: concat(commonEnv, [ { name: 'DMS_BASE_URL', value: 'http://document-management' } ])
  }
  {
    name: 'worker-suche-und-zuordnung'
    image: 'modul-suche-und-zuordnung'
    env: concat(commonEnv, [
      { name: 'DMS_BASE_URL', value: 'http://document-management' }
      { name: 'FORMAL_COMPLETENESS_SERVICE_URL', value: 'http://formal-completeness' }
      { name: 'QDRANT_BASE_URL', value: 'http://qdrant:6333' }
      { name: 'LAW_DATABASE_QUERY_TOP_K_DR_URL', value: 'http://gesetzesbegruendung-db/query_top_k' }
      { name: 'LAW_DATABASE_QUERY_K_RESULTS_UT_URL', value: 'http://jura-db/query_k_results' }
      { name: 'LAW_DATABASE_QUERY_CHUNKS_UT_URL', value: 'http://jura-db/chunks' }
    ])
  }
  {
    name: 'worker-plausibilitaet-pruefung'
    image: 'modul-plausibilitaet-pruefung'
    env: concat(commonEnv, [
      { name: 'DMS_BASE_URL', value: 'http://document-management' }
      { name: 'QDRANT_BASE_URL', value: 'http://qdrant:6333' }
    ])
  }
  {
    name: 'worker-anonymisierung'
    image: 'modul-anonymisierung'
    env: concat(commonEnv, [ { name: 'OTEL_SERVICE_NAME', value: 'anonymisierung-worker' } ])
  }
]

// ---- HTTP service apps (internal ingress) ----
resource httpApps 'Microsoft.App/containerApps@2023-05-01' = [for s in httpServices: {
  name: s.name
  location: location
  properties: {
    managedEnvironmentId: env.id
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: {
        external: false
        targetPort: 8000
        transport: 'http'
        allowInsecure: true
      }
      registries: registries
      secrets: commonSecrets
    }
    template: {
      containers: [
        {
          name: s.name
          image: '${registryServer}/${s.image}:${imageTag}'
          resources: { cpu: json('0.5'), memory: '1Gi' }
          env: appEnv[s.name]
        }
      ]
      scale: { minReplicas: 1, maxReplicas: 1 }
    }
  }
}]

// ---- Worker apps (no ingress) ----
resource workerApps 'Microsoft.App/containerApps@2023-05-01' = [for w in workers: {
  name: w.name
  location: location
  properties: {
    managedEnvironmentId: env.id
    configuration: {
      activeRevisionsMode: 'Single'
      registries: registries
      secrets: commonSecrets
    }
    template: {
      containers: [
        {
          name: w.name
          image: '${registryServer}/${w.image}:${imageTag}'
          resources: { cpu: json('0.5'), memory: '1Gi' }
          env: appEnv[w.name]
        }
      ]
      scale: { minReplicas: 1, maxReplicas: 1 }
    }
  }
}]

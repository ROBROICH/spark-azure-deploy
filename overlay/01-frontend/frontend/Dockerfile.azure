# Azure demo build: same as the stock frontend Dockerfile, but builds with base path "/"
# (so assets resolve at the root, no external /app gateway needed) and installs the
# nginx.azure.conf gateway that proxies /api/* to the internal Container Apps.
# Build context = 01-frontend/frontend. Build:  docker build -f Dockerfile.azure .
FROM node:24-alpine3.23 AS builder
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN corepack enable pnpm && pnpm install --frozen-lockfile
COPY . .
# Build with the default base path (/app); the nginx gateway serves the SPA under /app.
RUN pnpm run build

FROM nginx:1.30-alpine3.23-slim
RUN apk add --no-cache --upgrade \
    'libexpat>=2.7.5-r0' \
    'libpng>=1.6.56-r0' \
    'musl>=1.2.5-r23' \
    'musl-utils>=1.2.5-r23'
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.azure.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh
# Strip CRLF (Windows checkout) so the shebang and script run on Linux
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh
EXPOSE 80
CMD ["/docker-entrypoint.sh"]

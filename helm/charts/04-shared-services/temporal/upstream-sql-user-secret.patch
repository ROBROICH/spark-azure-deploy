--- /dev/null
+++ b/templates/_username-env.yaml
@@ -0,0 +1,12 @@
+{{- define "temporal.username-env" -}}
+{{- $root := index . 0 -}}
+{{- $store := index . 1 -}}
+{{- if $store.config.userSecretKey -}}
+valueFrom:
+  secretKeyRef:
+    name: {{ required (printf "SQL userSecretKey requires existingSecret for %s store" $store.name) $store.config.existingSecret | quote }}
+    key: {{ $store.config.userSecretKey | quote }}
+{{- else -}}
+value: {{ $store.config.user | quote }}
+{{- end -}}
+{{- end -}}

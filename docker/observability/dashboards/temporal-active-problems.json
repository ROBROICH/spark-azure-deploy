    {
      "id": 7,
      "type": "table",
      "title": "Checks for slow workflows",
      "description": "Time checks need 30 duration measurements. The limit is twice the historical duration shown here, with a five-minute minimum.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (temporal_namespace, workflow_type) ((2 * (group by (temporal_namespace, workflow_type) (spark_temporal_running{temporal_namespace=~\"$temporal_namespace\"} or spark_temporal_runtime_baseline_samples{temporal_namespace=~\"$temporal_namespace\"}) and on (workflow_type) (spark_temporal_runtime_alert_excluded == 1))) or (((spark_temporal_runtime_baseline_samples{temporal_namespace=~\"$temporal_namespace\"} >= bool 30) or (0 * group by (temporal_namespace, workflow_type) (spark_temporal_running{temporal_namespace=~\"$temporal_namespace\"} or spark_temporal_runtime_baseline_samples{temporal_namespace=~\"$temporal_namespace\"})))))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (temporal_namespace, workflow_type) (spark_temporal_runtime_baseline_samples{temporal_namespace=~\"$temporal_namespace\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (temporal_namespace, workflow_type) (spark_temporal_runtime_baseline_seconds{temporal_namespace=~\"$temporal_namespace\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (temporal_namespace, workflow_type) (spark_temporal_runtime_limit_seconds{temporal_namespace=~\"$temporal_namespace\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (temporal_namespace, workflow_type) (spark_temporal_running{temporal_namespace=~\"$temporal_namespace\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        }
      ],
      "transformations": [

DB_USER=postgres
# DB_PASSWORD=<set me in .env>
DB_NAME=dms
DB_HOST=localhost
DB_PORT=5432

## Service Configuration
SERVICE_NAME=dms
OTEL_SERVICE_NAME=dms
OTEL_ENDPOINT=http://localhost:4317
ENV=dev
CORS_ORIGINS=""
DOC_STORE_PATH=dms_data
CHECKPOINT_RETENTION_PERIOD_DAYS=60
TEMPORAL__HOST=localhost:7233
TEMPORAL__TASK_QUEUE=dms
TEMPORAL__PLS_TASK_QUEUE=project_logic_service
TEMPORAL__NAMESPACE=default
TEMPORAL__S3_BUCKET_NAME=temporal-payloads
TEMPORAL__S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL__S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL__S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL__S3_REGION=eu-west-1
TEMPORAL__ENABLE_APPROVAL=true

# MinIO Config (local development)
BUCKET_NAME=dms-local
S3_ENDPOINT_URL=http://localhost:9000
# External URL used for generating presigned URLs accessible outside the cluster.
# Addressing is forced to path-style in code, so this is a bare host (no bucket subdomain).
# When running behind a reverse proxy (WEB_HOST set), process-compose overrides this with S3_PUBLIC_URL (the frontend origin,
# served same-origin via oauth2-proxy) so browser uploads/downloads are not cross-origin.
S3_EXTERNAL_URL=http://localhost:9000
S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=<set me in .env>
# S3_SECRET_ACCESS_KEY=<set me in .env>

MAX_ZIP_ENTRIES=5000
MAX_COMPRESSION_RATIO=100
MAX_ZIP_EXTRACTION_SIZE_GB=10
MAX_SINGLE_ENTRY_SIZE_MB=1024
MAX_DIFF_HASH_CONCURRENCY=8


CLAMAV__ENABLED=false
CLAMAV__BASE_URL=http://localhost:6000
PROJECT_LOGIC_SERVICE_URL=http://localhost:18000
TEMPORAL_JOB_SERVICE_URL=http://localhost:18011

# Quarantine Bucket (local MinIO)
QUARANTINE_BUCKET_NAME=quarantine-bucket
QUARANTINE_S3_ENDPOINT_URL=http://localhost:9000
# QUARANTINE_S3_ACCESS_KEY_ID=<set me in .env>
# QUARANTINE_S3_SECRET_ACCESS_KEY=<set me in .env>

# Auth
AUTH_MODE=disabled

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
CLAMAV__TIMEOUT_SECONDS=600

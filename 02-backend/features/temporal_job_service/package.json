{
  "name": "@spark-workflow/temporal-job-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./schema": "./src/db/schema.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "profile:reads": "bun test test/read",
    "profile:status-mutation": "bun test test/mutation/status.test.ts --timeout 30000",
    "test": "bun test --preload @spark-workflow/test-support/evlog-disabled --isolate --dots",
    "typecheck": "tsgo --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1089.0",
    "@spark-workflow/http-host": "workspace:*",
    "@spark-workflow/postgres-runtime": "workspace:*",
    "@spark-workflow/resource": "workspace:*",
    "@spark-workflow/authentification": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "@spark-temporal/contracts": "workspace:*",
    "@spark-temporal/typescript": "workspace:*",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/proto": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "better-drizzle": "0.1.1",
    "better-result": "3.0.1",
    "drizzle-orm": "0.45.2",
    "drizzle-typebox": "0.3.3",
    "effect": "4.0.0-rc.112",
    "elysia": "1.4.29",
    "evlog": "2.25.0"
  },
  "devDependencies": {
    "@spark-workflow/test-support": "workspace:*",
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260425.1",
    "typescript": "5.9.3"
  }
}

exports[`POST /{project_id}/batch-nodes HTTP contract omitted version resolves once and returns the current-only full payload 1`] = `
{
  "body": {
    "results": [
      {
        "createdAt": "2026-04-09T15:05:58.977Z",
        "frontendParentIds": [
          "topic_norm:8836f757-1f94-4d9e-ad18-c94db7cd9807",
          "topic_norm:c57553ca-192f-468f-ae05-ea1d0923c6c9",
          "topic_norm:f4cd9a06-c071-4d46-a198-164c47bc6ba7",
        ],
        "gesetzId": "2f1e6535-3e9d-492b-8d72-673e8b8f057e",
        "id": "96e61655-b310-4ebe-a30d-e3c10f37fed1",
        "isDeleted": false,
        "isOutdated": false,
        "nodeType": "norm",
        "paragraphNr": "1",
        "paragraphTitel": "Zweck und Ziele des Gesetzes",
        "projectId": "e17baca1-af91-48d0-9702-9c34880d7046",
        "projectVersion": 1,
        "regelungsgegenstand": "Der Paragraph legt den Zweck und die Ziele des Energiewirtschaftsgesetzes fest. Dabei geht es um die sicherstellung einer sicheren, preisgünstigen, verbraucherfreundlichen, effizienten, umweltverträglichen und treibhausgasneutralen leitungsgebundenen Versorgung der Allgemeinheit mit Elektrizität, Gas und Wasserstoff, die zunehmend auf erneuerbaren Energien basiert. Zudem werden konkrete Zielsetzungen für die Regulierung der Elektrizitäts- und Gasversorgungsnetze genannt, wie den Wettbewerb, die Netzbetriebsicherheit, die Digitalisierung und den Ausbau erneuerbarer Energien. Schließlich dient das Gesetz der Umsetzung des europäischen Gemeinschaftsrechts im Bereich der leitungsgebundenen Energieversorgung und verfolgt dabei unter anderem die Stärkung der freien Preisbildung, des Elektrizitätsmarktes sowie der internationalen Zusammenarbeit.",
        "text": "Zweck des Gesetzes ist eine möglichst sichere, preisgünstige, verbraucherfreundliche, effiziente, umweltverträgliche und treibhausgasneutrale leitungsgebundene Versorgung der Allgemeinheit mit Elektrizität, Gas und Wasserstoff, die zunehmend auf erneuerbaren Energien beruht.\\nDie Regulierung der Elektrizitäts- und Gasversorgungsnetze dient den Zielen der Sicherstellung eines wirksamen und unverfälschten Wettbewerbs bei der Versorgung mit Elektrizität und Gas, der Sicherung eines langfristig angelegten leistungsfähigen und zuverlässigen Betriebs von Energieversorgungsnetzen sowie der gesamtwirtschaftlich optimierten Energieversorgung. Zur Verfolgung der Ziele in Absatz 1 berücksichtigt die Regulierung insbesondere\\n\\n1.\\n:   den vorausschauenden Ausbau, die optimierte Nutzung und die Digitalisierung der Energieversorgungsnetze,\\n\\n2.\\n:   die Erzeugung und Nutzung von Strom aus erneuerbaren Energien und Wasserstoff,\\n\\n3.\\n:   die Flexibilisierung im Elektrizitätssystem, einschließlich der Nutzung von Energiespeichern sowie\\n\\n4.\\n:   eine angemessene Verteilung der Netzkosten im Zusammenhang mit dem Ausbau der Stromerzeugung aus erneuerbaren Energien.\\nZweck dieses Gesetzes ist ferner die Umsetzung und Durchführung des Europäischen Gemeinschaftsrechts auf dem Gebiet der leitungsgebundenen Energieversorgung.\\nUm den Zweck des Absatzes 1 auf dem Gebiet der leitungsgebundenen Versorgung der Allgemeinheit mit Elektrizität zu erreichen, verfolgt dieses Gesetz insbesondere die Ziele,\\n\\n1.\\n:   die freie Preisbildung für Elektrizität durch wettbewerbliche Marktmechanismen zu stärken,\\n\\n2.\\n:   den Ausgleich von Angebot und Nachfrage nach Elektrizität an den Strommärkten jederzeit zu ermöglichen,\\n\\n3.\\n:   dass Erzeugungsanlagen, Anlagen zur Speicherung elektrischer Energie und Lasten insbesondere möglichst umweltverträglich, netzverträglich, effizient und flexibel in dem Umfang eingesetzt werden, der erforderlich ist, um die Sicherheit und Zuverlässigkeit des Elektrizitätsversorgungssystems zu gewährleisten, und\\n\\n4.\\n:   den Elektrizitätsbinnenmarkt zu stärken sowie die Zusammenarbeit insbesondere mit den an das Gebiet der Bundesrepublik Deutschland angrenzenden Staaten sowie mit dem Königreich Norwegen und dem Königreich Schweden zu intensivieren.",
        "updateType": "automated",
        "updatedAt": "2026-04-09T15:05:58.977Z",
      },
      {
        "createdAt": "2026-04-09T15:05:58.977Z",
        "frontendParentIds": [

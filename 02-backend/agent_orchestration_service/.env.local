## Service Configuration
SERVICE_NAME=agent-orchestration-service
CORS_ORIGINS=""

# This is a json that you need to put here like
#DIPLAN__SECRET={"develop": {"keycloak_token_url": "<host>/realms/diplanung-develop/protocol/openid-connect/token","client_secret": "<omitted>","dms_base_url": "<dms url from diplan not ours>"},"integration": {"keycloak_token_url": "<host>/realms/diplanung-integration/protocol/openid-connect/token","client_secret": "<omitted>","dms_base_url": "<dms url from diplan not ours>"}}

## Temporal
TEMPORAL__HOST=localhost:7233
TEMPORAL__TASK_QUEUE=orchestration
TEMPORAL__S3_BUCKET_NAME=temporal-payloads
TEMPORAL__S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL__S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL__S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL__S3_REGION=eu-west-1

## Service URLs
API__PLS_BASE_URL=http://localhost:18000
API__DIPLAN_BASE_URL=http://localhost:18004
API__FVP_BASE_URL=http://localhost:18002
API__FPP_BASE_URL=http://localhost:18007
API__DMS_BASE_URL=http://localhost:18001
API__PLAUSIBILITY_NOTES_BASE_URL=http://localhost:18005
API__EXAMINATION_SERVICE_BASE_URL=http://localhost:18009
API__ADMINISTRATIVE_FILE_DRAFT_BASE_URL=http://localhost:18010
API__OBJECTIONS_SERVICE_BASE_URL=http://localhost:18006
TEMPORAL_JOB_SERVICE_URL=http://localhost:18011

USE_TRANSFER_ENCODING_CHUNKED=false  # enable chunked uploads (Ceph-backed flows only)

## Observability
OTEL_SERVICE_NAME=orchestrator       # OpenTelemetry service name
OTEL_ENDPOINT=http://localhost:4317  # OpenTelemetry collector gRPC endpoint

## DIPLAN
# DIPLAN__SECRET is a JSON map of per-env credentials, e.g.
#   DIPLAN__SECRET={"develop": {"keycloak_token_url": "...", "client_secret": "...", "dms_base_url": "..."}}
# Leave empty locally if DIPLAN integration is not used.
# DIPLAN__SECRET=<set me in .env>

## FPP
# FPP uses individual environment variables (patched by K8s per environment)
FPP__KEYCLOAK_TOKEN_URL=http://localhost:9999/openid-connect/token
# FPP__CLIENT_ID=<set me in .env>
# FPP__CLIENT_SECRET=<set me in .env>
# FPP__USERNAME=<set me in .env>
# FPP__PASSWORD=<set me in .env>

# CI-only, not read by app. Auth is injected by k8s overlays in production/staging/testing.
AUTH_MODE=disabled

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
TEMPORAL__NAMESPACE=default
API__TIMEOUT=600

# Ignore everything by default
**

# Root workspace files
!pyproject.toml
!uv.lock

# All pyproject.toml files for dependency resolution
!**/pyproject.toml
.venv/**

# Workspace and used shared libraries
!02-backend/logging
!04-shared-services/authentification
!04-shared-services/temporal
!04-shared-services/audit-client
!04-shared-services/alembic-utils

# Allow module code
!02-backend/temporal_job_service/src/**
!02-backend/temporal_job_service/README.md
!02-backend/temporal_job_service/alembic.ini

# Re-ignore Python junk everywhere
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

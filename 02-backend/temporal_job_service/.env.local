## Service Configuration
SERVICE_NAME=temporal-job-service

## Temporal connection
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

## Workflow complexity / load weighting
# MAX_SYSTEM_COMPLEXITY defaults to the sum of WORKFLOW_COMPLEXITY values
# in src/config/settings.py (currently 22584.5). Override to scale load %.
MAX_SYSTEM_COMPLEXITY=22584.5

# DEFAULT_WORKFLOW_COMPLEXITY_WEIGHT is the weight applied to any workflow
# type not present in WORKFLOW_COMPLEXITY.
DEFAULT_WORKFLOW_COMPLEXITY_WEIGHT=3

# WORKFLOW_COMPLEXITY is a JSON object mapping workflow type -> weight.
# Leave unset to use the in-code defaults from settings.py.
# WORKFLOW_COMPLEXITY={"FVPWorkflow":5900,"bewertung":130,...}

## Auth (deployment-injected in production overlay; safe to leave unset locally)
# AUTH_BASE_URL=
# AUTH_REALM=
# AUTH_AUDIENCE=
# AUTH_MODE=disabled
# AUTH_SPICE_DB_ENDPOINT=
# AUTH_SPICE_DB_TOKEN=<set me in .env>
# AUTH_SPICE_DB_INSECURE=true


# Database
DB__USER=postgres
DB__HOST=localhost
# DB__PASSWORD=<set me in .env>
DB__NAME=temporal_job_service_db
DB__PORT=5432

TEMPORAL__HOST=localhost:7233
TEMPORAL__TASK_QUEUE=temporal-job-service
TEMPORAL__S3_BUCKET_NAME=temporal-payloads
TEMPORAL__S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL__S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL__S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL__S3_REGION=eu-west-1

TEMPORAL__S3_ARCHIVAL_BUCKET_NAME=temporal-archival

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
OTEL_SERVICE_NAME=temporal-job-service
OTEL_ENDPOINT=http://localhost:4317
TEMPORAL__NAMESPACE=default
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_SECONDS=120
RECONCILER_BATCH_SIZE=500
RECONCILER_BACKFILL_WINDOW_MINUTES=30
RECONCILER_PENDING_TIMEOUT_MINUTES=1440
ARCHIVAL_ENABLED=true
ARCHIVAL_CRON=0 0 * * 0
ARCHIVAL_BATCH_SIZE=100
ARCHIVAL_ACTIVITY_TIMEOUT_SECONDS=300
ARCHIVAL_S3_PREFIX=temporal-history
ARCHIVAL_WORKFLOW_ID=WeeklyArchivalWorkflow
# ARCHIVAL_ENCRYPTION_KEY=<set me in .env>

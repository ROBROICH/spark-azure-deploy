APP_PORT=18013
SERVICE_NAME=identity-management-service

DB_USER=postgres
# DB_PASSWORD=<set me in .env>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_management_db

AUTH_MODE=optional_verify_dry_run
AUTH_BASE_URL=http://localhost:8080
AUTH_REALM=master
AUTH_AUDIENCE=identity-management-service
AUTH_SPICE_DB_ENDPOINT=localhost:50051
# AUTH_SPICE_DB_TOKEN=<set me in .env>
AUTH_SPICE_DB_INSECURE=true

IDENTITY_MANAGEMENT_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

TEMPORAL_JOB_SERVICE_URL=http://localhost:18011

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=<set me in .env>
AUTH_PRIVILEGED_REALM=master
AUTH_PRIVILEGED_CLIENT_ID=role-changer
# AUTH_PRIVILEGED_CLIENT_SECRET=<set me in .env>

# Ignore everything by default
**

# Root workspace files
!pyproject.toml
!uv.lock

# All pyproject.toml files for dependency resolution
!**/pyproject.toml
.venv/**

# Workspace dependency sources
!02-backend/logging/src/**
!04-shared-services/authentification/src/**
!04-shared-services/internal-auth/**

# Workspace and used shared libraries
!02-backend/logging
!04-shared-services/authentification

# Allow module code
!02-backend/identity_management_service/src/**
!02-backend/identity_management_service/README.md
!02-backend/identity_management_service/alembic.ini

# Re-ignore Python junk everywhere
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

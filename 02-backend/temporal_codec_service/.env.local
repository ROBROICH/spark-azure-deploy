# S3-compatible storage used by the Temporal payload codec to off-load
# payloads larger than 100 KB so they remain viewable in the Temporal UI.
TEMPORAL_S3_BUCKET_NAME=temporal-payloads
TEMPORAL_S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL_S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL_S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL_S3_REGION=us-east-1

# Uvicorn bind address. Read directly from os.environ in main.py
# (not part of the pydantic Settings model in env.py).
# HOST defaults to 0.0.0.0 and PORT defaults to 8000 when unset.
HOST=0.0.0.0
PORT=8000

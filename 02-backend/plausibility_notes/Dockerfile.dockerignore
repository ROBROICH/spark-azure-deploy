# Ignore everything by default
**

# Root workspace files
!pyproject.toml
!uv.lock

# All pyproject.toml files for dependency resolution
!**/pyproject.toml
.venv/**

# Workspace and used shared libraries
!02-backend/logging
!04-shared-services/audit-client
!04-shared-services/internal-auth
!04-shared-services/alembic-utils
!04-shared-services/node-crud
!04-shared-services/authentification

# Allow module code
!02-backend/plausibility_notes/src/**
!02-backend/plausibility_notes/alembic.ini
!02-backend/plausibility_notes/README.md

# Re-ignore Python junk everywhere
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

{
  "name": "@spark-workflow/spark-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "db:boundaries": "drizzle-kit generate --config=drizzle.config.ts --custom --name database_boundaries && bun ../../../scripts/database-boundaries.ts generate src/migrations",
    "db:check": "bun ../../../scripts/database-boundaries.ts check src/migrations",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --preload @spark-workflow/test-support/evlog-disabled --isolate --dots",
    "typecheck": "tsgo --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@spark-workflow/administrative-file-draft": "workspace:*",
    "@spark-workflow/agent-orchestration-service": "workspace:*",
    "@spark-workflow/comment-service": "workspace:*",
    "@spark-workflow/core": "workspace:*",
    "@spark-workflow/examination-service": "workspace:*",
    "@spark-workflow/feedback-service": "workspace:*",
    "@spark-workflow/formal-completeness-check": "workspace:*",
    "@spark-workflow/fpp-service": "workspace:*",
    "@spark-workflow/http-host": "workspace:*",
    "@spark-workflow/identity-management-service": "workspace:*",
    "@spark-workflow/objections-management-service": "workspace:*",
    "@spark-workflow/plausibility-notes": "workspace:*",
    "@spark-workflow/postgres-runtime": "workspace:*",
    "@spark-workflow/protocol-service": "workspace:*",
    "@spark-workflow/resource": "workspace:*",
    "@spark-workflow/supplementary-requests-service": "workspace:*",
    "@spark-workflow/temporal-job-service": "workspace:*",
    "@spark-workflow/audit-client": "workspace:*",
    "@elysiajs/cors": "1.4.2",
    "@sinclair/typebox": "0.34.52",
    "effect": "4.0.0-rc.112",
    "elysia": "1.4.29",
    "evlog": "2.25.0"
  },
  "devDependencies": {
    "@spark-workflow/test-support": "workspace:*",
    "@types/bun": "1.4.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260425.1"
  }
}

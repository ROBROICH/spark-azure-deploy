DB_USER=postgres
# DB_PASSWORD=<set me in .env>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_logic

SERVICE_NAME=project-logic-service
PROJECT_LOGIC_SERVICE_CORS_ORIGINS=http://localhost:3000
API__ADMINISTRATIVE_FILE_DRAFT_BASE_URL=http://localhost:18010
API__OBJECTIONS_BASE_URL=http://localhost:18006
API__PLS_BASE_URL=http://localhost:18000
API__DMS_BASE_URL=http://localhost:18001
API__FCS_BASE_URL=http://localhost:18002
API__PLAUSIBILITY_BASE_URL=http://localhost:18005
API__EXAMINATION_BASE_URL=http://localhost:18009

TEMPORAL_JOB_SERVICE_URL=http://localhost:18011

## Temporal
TEMPORAL__HOST=localhost:7233
TEMPORAL__TASK_QUEUE=project_logic_service
TEMPORAL__NAMESPACE=default
TEMPORAL__S3_BUCKET_NAME=temporal-payloads
TEMPORAL__S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL__S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL__S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL__S3_REGION=eu-west-1

AUTH_MODE=optional_verify_dry_run
AUTH_BASE_URL=http://localhost:8080
AUTH_REALM=master
AUTH_AUDIENCE=test-client
AUTH_SPICE_DB_ENDPOINT=localhost:50051
# AUTH_SPICE_DB_TOKEN=<set me in .env>
AUTH_SPICE_DB_INSECURE=true

OTEL_SERVICE_NAME=project_logic_service
OTEL_ENDPOINT=http://localhost:4317

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
API__TIMEOUT=60

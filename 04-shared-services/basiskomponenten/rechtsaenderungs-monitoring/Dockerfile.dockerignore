# Ignore everything by default
**

# Root workspace files
!pyproject.toml
!uv.lock

# All pyproject.toml files for dependency resolution
!**/pyproject.toml
.venv/**

# Workspace and used shared libraries
!04-shared-services/db-services/shared/**
!04-shared-services/audit-client/**
!04-shared-services/temporal/**
!04-shared-services/authentification/**
!04-shared-services/internal-auth/**
!02-backend/logging/**

# Allow module code
!04-shared-services/basiskomponenten/rechtsaenderungs-monitoring/rechtsaenderungsmonitoring/**
!04-shared-services/basiskomponenten/rechtsaenderungs-monitoring/alembic/**
!04-shared-services/basiskomponenten/rechtsaenderungs-monitoring/alembic.ini
!04-shared-services/basiskomponenten/rechtsaenderungs-monitoring/README.md

# Re-ignore Python junk everywhere
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

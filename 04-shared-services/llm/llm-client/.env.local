ENV=dev

# LiteLLM Proxy
# LITELLM_BASE_URL=<set me in .env>
# LITELLM_MASTER_KEY="<set me in .env>"

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=llm
TEMPORAL_S3_BUCKET_NAME=temporal-payloads
TEMPORAL_S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL_S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL_S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL_S3_REGION=eu-west-1

# Worker tuning
QUEUES='[
  {"NAME": "llm-nvidia",  "MAX_CONCURRENT": 3, "MAX_PER_SECOND": 5},
  {"NAME": "llm-ionos",   "MAX_CONCURRENT": 8,  "MAX_PER_SECOND": 10},
  {"NAME": "llm-mistral", "MAX_CONCURRENT": 8,  "MAX_PER_SECOND": 15},
  {"NAME": "llm-vertex",  "MAX_CONCURRENT": 8,  "MAX_PER_SECOND": 20},
  {"NAME": "llm-huggingface",  "MAX_CONCURRENT": 250,  "MAX_PER_SECOND": 50},
  {"NAME": "llm-custom",  "MAX_CONCURRENT": 8,  "MAX_PER_SECOND": 20}
]'

# Monitoring
OTEL_SERVICE_NAME=llm-client
OTEL_ENDPOINT=http://localhost:4317

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
# LITELLM_DISK_CACHE_DIR= (optional)
# QUEUE_NAME= / QUEUE_MAX_CONCURRENT= / QUEUE_MAX_PER_SECOND= (required only when ENV != dev; dev uses QUEUES)

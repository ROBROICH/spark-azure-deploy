# Ignore everything by default
**

# Shared Python image build steps (docker/python-build/README.md)
!docker/python-build/*.sh

# Root workspace files
!pyproject.toml
!uv.lock

# All pyproject.toml files for dependency resolution
!**/pyproject.toml
.venv/**

# Workspace and used shared libraries
!packages/db-services-shared/**
!packages/audit-client/**
!packages/temporal
!packages/temporal/python/**
!packages/authentification/**
!packages/event-logging/**

# Allow module code
!04-shared-services/db-services/jura-db-service/jura_db/**
!04-shared-services/db-services/jura-db-service/alembic/**
!04-shared-services/db-services/jura-db-service/alembic.ini
!04-shared-services/db-services/jura-db-service/README.md

# Re-ignore Python junk everywhere
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

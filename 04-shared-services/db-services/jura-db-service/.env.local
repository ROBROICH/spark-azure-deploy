SERVICE_NAME=jura-db-service
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

DB_NAME=jura-db
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
# DB_PASSWORD=<set me in .env>

CACHE_DIR=cached
GESETZE_NORMEN_URL="http://localhost:18020"

CHUNKING_PROVIDER=test
CHUNKING_MODEL="self-hosted/BAAI/bge-m3"
CHUNKING_URL="https://litellm.example.com/v1"
# CHUNKING_APIKEY=<set me in .env>
CHUNKING_SIZE=2048
CHUNKING_OVERLAP=256

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_S3_BUCKET_NAME=temporal-payloads
TEMPORAL_S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL_S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL_S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL_S3_REGION=eu-west-1
TEMPORAL_JOB_SERVICE_URL=http://localhost:18011

# Temporal-Monitoring
OTEL_SERVICE_NAME="jura-db-worker"
OTEL_ENDPOINT="http://localhost:4317"

# Auth
AUTH_MODE=disabled

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
DB_POOLSIZE=10
DB_MAXOVERFLOW=5
CHUNKING_TIMEOUT=5.0
CHUNKING_DIMENSIONS=1024
RII_BASE_DOCUMENT_URL=http://www.rechtsprechung-im-internet.de/jportal/docs/bsjrs

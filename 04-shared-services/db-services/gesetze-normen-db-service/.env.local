SERVICE_NAME="Gesetze & Normen DB / Paragraphensuche"
LOG_LEVEL=DEBUG
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

DB_NAME=gesetze-normen
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
# DB_PASSWORD=<set me in .env>

CACHE_DIR=cached

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_S3_BUCKET_NAME=temporal-payloads
TEMPORAL_S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL_S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL_S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL_S3_REGION=eu-west-1
TEMPORAL_JOB_SERVICE_URL=http://localhost:18015

# Temporal-Monitoring
OTEL_SERVICE_NAME="gesetze-normen-db-worker"
OTEL_ENDPOINT="http://localhost:4317"

# Auth
AUTH_MODE=disabled

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
DB_POOLSIZE=10
DB_MAXOVERFLOW=5

    <norm builddate="20260501121530" doknr="BJNRTEST2">
        <metadaten>
            <jurabk>Test2G</jurabk>
            <enbez>§ 1</enbez>
            <titel format="XML">Zweck des Gesetzes</titel>
        </metadaten>
        <textdaten>
            <text format="XML">
                <Content>
                    <P>(1) Zweck dieses Gesetzes ist die Regelung des Testbetriebs.</P>
                    <P>(2) Die Regulierung dient
                        <DL Font="normal" Type="arabic">
                            <DT>1.</DT>
                            <DD Font="normal">
                                <LA Size="normal">der Versorgungssicherheit durch den vorausschauenden Ausbau, die optimierte Nutzung der Testsuite,</LA>
                            </DD>
                            <DT>2.</DT>
                            <DD Font="normal">
                                <LA Size="normal">der Effizienz des Testbetriebs.</LA>
                            </DD>
                        </DL>
                    </P>
                </Content>
            </text>
            <fussnoten/>
        </textdaten>
    </norm>

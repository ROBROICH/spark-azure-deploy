diff --git a/04-shared-services/db-services/shared/db_services_shared/llm/embeddings.py b/04-shared-services/db-services/shared/db_services_shared/llm/embeddings.py
index a4676e6..74dbf32 100644
--- a/04-shared-services/db-services/shared/db_services_shared/llm/embeddings.py
+++ b/04-shared-services/db-services/shared/db_services_shared/llm/embeddings.py
@@ -40,12 +40,16 @@ class EmbeddingClient:
                     headers = {
                         "Authorization": f"Bearer {self.profile.apikey}",
                     }
-                    if dimensions is not None:
-                        logger.warning("dimensions set, but ignoring for litelllm provider")
+                    # Request the configured embedding dimension (CHUNKING_DIMENSIONS) from the
+                    # provider. OpenAI text-embedding-3-* honour the ``dimensions`` parameter, and
+                    # the pgvector columns are VECTOR(1024); without this the API returns 1536-dim
+                    # vectors that fail to bind against the 1024-dim column (HTTP 500 on query).
+                    embedding_dimensions = dimensions if dimensions is not None else self.profile.dimensions
                     self.model = OpenAIEmbeddings(
                         openai_api_key=config.apikey,
                         openai_api_base=config.url.encoded_string(),
                         model=config.model,
+                        dimensions=embedding_dimensions,
                         default_headers=headers.copy(),
                         check_embedding_ctx_length=False,
                         timeout=config.timeout,

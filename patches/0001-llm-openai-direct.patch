+def resolve_chat_model(model: str) -> str:
+    """Map a routing alias to the configured OpenAI chat model.
+
+    The demo calls the OpenAI API directly instead of a multi-provider LiteLLM
+    proxy, so provider-prefixed aliases (``self-hosted/gpt-oss-120b``,
+    ``gcp/gemini-2.0-flash`` …) are not valid OpenAI model IDs. Collapse them all
+    to the single configured OpenAI text model.
+    """
+    return ENV.LITELLM.TEXT_MODEL
+
+
+def resolve_embedding_model(model: str) -> str:
+    """Map a routing alias to the configured OpenAI embedding model."""
+    return ENV.LITELLM.EMBEDDING_MODEL
+
+
+# OpenAI reasoning models (gpt-5.x and the o-series) require ``max_completion_tokens``
+# (not ``max_tokens``) and only accept the default sampling params: ``temperature`` and
+# ``top_p`` must be 1, and frequency/presence penalties are unsupported. Sending any other
+# value returns HTTP 400 — which is retryable here, so a bad value hangs the workflow.
+_REASONING_MODEL_PREFIXES = ("gpt-5", "o1", "o3", "o4")
+
+
+def is_reasoning_model(model: str) -> bool:
+    """Return True for OpenAI reasoning models (gpt-5.x, o-series).
+
+    The model string may be bare (``gpt-5.4-mini``) or proxy-prefixed
+    (``openai/gpt-5.4-mini``).
+    """
+    name = model.lower().rsplit("/", 1)[-1]
+    return name.startswith(_REASONING_MODEL_PREFIXES)

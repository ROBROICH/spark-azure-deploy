+def _caused_by_norm_not_found(err: BaseException) -> bool:
+    """True if the error chain contains a NormNotFound ApplicationError (norm text absent from DB)."""
+    current: BaseException | None = err
+    for _ in range(20):
+        if current is None:
+            break
+        if isinstance(current, ApplicationError) and current.type == "NormNotFound":
+            return True
+        current = current.__cause__
+    return False

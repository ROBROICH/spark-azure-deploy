+@pytest.mark.asyncio
+async def test_mvp_workflow_skips_when_norm_not_found(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A norm whose text is absent from gesetze-normen-db (404) is skipped, not failed."""
+    project_id = uuid4()
+    monkeypatch.setattr(workflow_module.workflow, "logger", MagicMock())
+
+    async def raise_norm_not_found(*_args: Any, **_kwargs: Any) -> Any:
+        raise ApplicationError(
+            "Norm document not found in gesetze-normen-db: ThürWaldG",
+            type="NormNotFound",
+            non_retryable=True,
+        )
+
+    monkeypatch.setattr(
+        "src.workflows.mvp.workflow._run_rechtsmethodik_and_insert",
+        raise_norm_not_found,
+    )
+
+    result = await MVPWorkflow().run(
+        MVPWorkflowInput(project_id=project_id, jurabk="ThürWaldG", paragraph_nr="1")
+    )
+
+    assert result.skipped is True
+    assert result.norm_id is None
+    assert result.jurabk == "ThürWaldG"
+    assert result.project_id == project_id
+
+

+logger = logging.getLogger("agent_orchestration.lifespan")
+
+
+def _log_worker_exit(task: "asyncio.Task[Any]") -> None:
+    """Surface a silently-dying Temporal worker task (its exception is otherwise swallowed)."""
+    if task.cancelled():
+        return
+    exc = task.exception()
+    if exc is None:
+        return
+    app_state.worker_alive = False
+    tb = "".join(traceback.format_exception(type(exc), exc, exc.__traceback__))
+    logger.error("Temporal worker task exited unexpectedly:\n%s", tb)
+    # Guaranteed-visible fallback in ACA console logs (distinct marker for grepping).
+    print(f"[WORKER-DIED] Temporal worker task exited unexpectedly:\n{tb}", flush=True)
+
 

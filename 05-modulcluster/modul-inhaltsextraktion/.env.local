# =============================================================================
# modul-inhaltsextraktion — shared development config (tracked in git)
# Secrets and per-developer overrides go in .env (gitignored)
# =============================================================================


# -----------------------------------------------------------------------------
# LiteLLM Proxy
# -----------------------------------------------------------------------------
# LITELLM_BASE_URL=<set me in .env>
# LITELLM_MASTER_KEY=<set me in .env>

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
DMS_BASE_URL="http://localhost:18001/api/dms/v1"

# LibreOffice UNO
UNO_HOST="localhost"
UNO_PORT="2003"
UNO_PROTOCOL="http"

# -----------------------------------------------------------------------------
# Extraction Provider
# -----------------------------------------------------------------------------
EXTRACTION_PROVIDER=docling

DOCLING_HOST=localhost
DOCLING_PORT=5001
DOCLING_PROTOCOL=http
DOCLING_OCR_ENGINE=easyocr  # "rapidocr" for CPU, "easyocr" for GPU

# -----------------------------------------------------------------------------
# LLM Models (routed via LiteLLM — only model names needed)
# -----------------------------------------------------------------------------
#VLLM_MODEL="mistral-small-2506"
#METADATA_MODEL_NAME="ministral-14b-2512"
#SCHWERPUNKTTHEMA_MODEL_NAME="mistral-small-2506"
#SUMMARIZATION_MODEL_NAME="ministral-14b-2512"
#VLM_SUMMARY_MODEL_NAME="mistral-small-2506"
#STRUCTURE_MODEL_NAME="mistral-small-2506"

#VLLM_MODEL="mistral-small-2506"
METADATA_MODEL_NAME="self-hosted/gpt-oss-120b"
SCHWERPUNKTTHEMA_MODEL_NAME="self-hosted/gpt-oss-120b"
SUMMARIZATION_MODEL_NAME="self-hosted/gpt-oss-120b"
VLM_SUMMARY_MODEL_NAME="self-hosted/gpt-oss-120b"
STRUCTURE_MODEL_NAME="self-hosted/gpt-oss-120b"

VLLM_MODEL="self-hosted/gemma-4-26b-a4b-it-maas"

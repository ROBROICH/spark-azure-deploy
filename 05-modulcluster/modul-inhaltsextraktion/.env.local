# STRUCTURE_MODEL_NAME="self-hosted/gpt-oss-120b"


# -----------------------------------------------------------------------------
# Qdrant / Embedding
# -----------------------------------------------------------------------------
QDRANT_BASE_URL="http://localhost:6333"
QDRANT_DENSE_VECTOR_SIZE=1024
EMBEDDING_MODEL="self-hosted/bge-m3"
QDRANT_COLLECTION_NAME="data"


# -----------------------------------------------------------------------------
# Temporal
# -----------------------------------------------------------------------------
TEMPORAL_SERVER_URL="localhost:7233"
TEMPORAL_S3_BUCKET_NAME=temporal-payloads
TEMPORAL_S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL_S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL_S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL_S3_REGION=eu-west-1

# -----------------------------------------------------------------------------
# Workflow Settings
# -----------------------------------------------------------------------------
SINGLE_DOCUMENT_WORKFLOW_CONCURRENCY=3 # how many documents get processed in parallel in the single-document workflow
SINGLE_DOCUMENT_EWMS_WORKFLOW_CONCURRENCY=5 # how many documents get processed in parallel in the single-document-ewms workflow
EXTRACTION_CHUNK_CONCURRENCY=1 # how many document chunks docling processes in parallel for big documents > 40 MB. Smaller documents do not get chunked

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME="inhaltsextraktion"
OTEL_ENDPOINT="http://localhost:4317"

# -----------------------------------------------------------------------------
# Prompt Injection Detection
# -----------------------------------------------------------------------------
INJECTION_LLM_MODEL=self-hosted/gpt-oss-120b
# INJECTION_MODEL_URL=<set me in .env>
# INJECTION_MODEL_TOKEN=<set me in .env>
INJECTION_LLM_SCAN_ENABLED=True
INJECTION_MODEL_SCAN_ENABLED=False

TEMPORAL_JOB_SERVICE_URL=http://localhost:18015/api

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
STRUCTURE_NODE_MAX_NODE_CHARS=128000
PAGE_INDEX_MIN_TOKEN_THRESHOLD=200
HYBRID_EXTRACTION_DOCLING_CONCURRENCY=1
HYBRID_EXTRACTION_OCR_CONCURRENCY=5
# QDRANT_API_KEY=<set me in .env>

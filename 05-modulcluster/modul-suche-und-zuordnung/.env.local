# =============================================================================
# Non-sensitive local defaults. Committed to git.
# Credentials belong in .env (gitignored).
# =============================================================================

# LLM Models 
LLM_EMBEDDING_MODEL=self-hosted/bge-m3
LLM_PAGEINDEX_SVM_MODEL_STAGE1=self-hosted/gpt-oss-120b
LLM_PAGEINDEX_SVM_MODEL_STAGE2=self-hosted/gpt-oss-120b
LLM_DB_RESEARCH_MODEL=self-hosted/gpt-oss-120b

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_S3_BUCKET_NAME=temporal-payloads
TEMPORAL_S3_ENDPOINT_URL=http://localhost:9000
TEMPORAL_S3_REGION=eu-west-1
# TEMPORAL_S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL_S3_SECRET_ACCESS_KEY=<set me in .env>

# Observability
OTEL_SERVICE_NAME=modul-suche-und-zuordnung
OTEL_ENDPOINT=http://localhost:4317

# FCS (Formal Completeness Check)
FCS_BASE_URL=http://localhost:18002
FCS_TIMEOUT=60

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=data

# Law databases
LAW_DATABASE_DKE_BASE_URL=http://localhost:18021
LAW_DATABASE_UT_BASE_URL=http://localhost:18022

# Runtime
PYTHONUNBUFFERED=1
FORCE_COLOR=1

TEMPORAL_JOB_SERVICE_URL=http://localhost:18011

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
LLM_PAGEINDEX_SVM_STAGE1_MAX_INPUT_TOKENS=70000
LLM_PAGEINDEX_SVM_STAGE2_MAX_INPUT_TOKENS=70000

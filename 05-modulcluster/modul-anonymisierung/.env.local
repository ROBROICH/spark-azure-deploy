# LLM (model + inference params, routed via shared temporal activities)
LLM_MODEL=self-hosted/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_PAGES_PER_CALL=3

# Kill switch: set to false to disable LLM detection (Presidio-only baseline)
LLM_ENABLED=true

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=2
TEMPORAL_THREAD_MAX_WORKERS=4
TEMPORAL_S3_BUCKET_NAME=temporal-payloads
TEMPORAL_S3_ENDPOINT_URL=http://localhost:9000
# TEMPORAL_S3_ACCESS_KEY_ID=<set me in .env>
# TEMPORAL_S3_SECRET_ACCESS_KEY=<set me in .env>
TEMPORAL_S3_REGION=eu-west-1
TEMPORAL_JOB_SERVICE_URL=http://localhost:18011

# Observability
OTEL_SERVICE_NAME=anonymisierung
OTEL_ENDPOINT=http://localhost:4317

# OCR
OCR_JOBS=2

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
LLM_TOP_P=1.0
LLM_MAX_PROMPT_SIZE=300000

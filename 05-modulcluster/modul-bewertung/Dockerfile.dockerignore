# Ignore everything by default
**

# Root workspace files
!pyproject.toml
!uv.lock

# All pyproject.toml files for dependency resolution
!**/pyproject.toml
.venv/**

# Workspace and used shared libraries
!04-shared-services/prompt-injection
!02-backend/logging
!04-shared-services/audit-client
!04-shared-services/internal-auth
!04-shared-services/temporal
!04-shared-services/authentification

# Allow module code
!05-modulcluster/modul-bewertung/README.md
!05-modulcluster/modul-bewertung/main.py
!05-modulcluster/modul-bewertung/src/**

# Re-ignore Python junk everywhere
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

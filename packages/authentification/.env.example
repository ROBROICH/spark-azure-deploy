# When AUTH_MODE=disabled other variables can be omitted
AUTH_MODE=disabled

AUTH_BASE_URL=http://localhost:8080
AUTH_REALM=master
AUTH_AUDIENCE=test-client
AUTH_ALLOWED_MACHINE_IDENTITIES=

AUTH_SPICE_DB_ENDPOINT=localhost:50051
# AUTH_SPICE_DB_TOKEN=<set me in .env>
AUTH_SPICE_DB_INSECURE=true

# --- explicit values for the remaining settings the service reads (no hidden code defaults) ---
AUTH_JWKS_URL=
AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=<set me in .env>
AUTH_PRIVILEGED_REALM=
AUTH_PRIVILEGED_CLIENT_ID=
# AUTH_PRIVILEGED_CLIENT_SECRET=<set me in .env>
AUTH_SPICE_DB_CERT_PATH=
AUTH_SPICE_DB_BULK_CHUNK_SIZE=1000
SERVICE_NAME=my-service

{
  "name": "@spark-workflow/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./schema": "./src/schema.ts",
    "./search": "./src/search.ts",
    "./projects": "./projects/src/index.ts",
    "./projects/data": "./projects/src/data.ts",
    "./projects/resource": "./projects/src/resource.ts",
    "./projects/runtime": "./projects/src/runtime.ts",
    "./projects/schema": "./projects/src/db/schema.ts",
    "./documents": "./documents/src/index.ts",
    "./documents/data": "./documents/src/data.ts",
    "./documents/env": "./documents/src/env.ts",
    "./documents/resource": "./documents/src/resource.ts",
    "./documents/schema": "./documents/src/db/schema.ts",
    "./usecases": "./usecases/src/index.ts",
    "./usecases/formats": "./usecases/src/formats.ts",
    "./usecases/resource": "./usecases/src/resource.ts",
    "./usecases/routes": "./usecases/src/routes.ts",
    "./usecases/schema": "./usecases/src/schema.ts",
    "./usecases/validate": "./usecases/src/validate.ts"
  },
  "scripts": {
    "lint:usecases": "bun usecases/scripts/lint.ts",

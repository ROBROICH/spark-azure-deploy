        "entityId": "99999999-9999-4999-8999-999999999999",
        "changeType": "delete"
      }
    },
    {
      "input": {
        "entityType": "record",
        "entityId": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
        "changeType": "action",
        "actionType": "reviewed"
      },
      "expected": {
        "entityType": "record",
        "entityId": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
        "changeType": "action",
        "actionType": "reviewed"
      }
    }
  ],
  "invalidChanges": [
    {
      "name": "action needs a concrete action type",
      "input": {
        "entityType": "record",
        "entityId": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
        "changeType": "action"
      }
    },
    {
      "name": "entity type cannot be empty",
      "input": {
        "entityType": "  ",
        "entityId": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
        "changeType": "update"
      }
    },
    {
      "name": "entity id is a UUID",
      "input": {
        "entityType": "record",
        "entityId": "not-a-uuid",
        "changeType": "delete"
      }
    },
    {
      "name": "unexpected change properties fail closed",
      "input": {

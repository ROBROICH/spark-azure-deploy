        "entityType": "record",
        "entityId": "77777777-7777-4777-8777-777777777777",
        "changeType": "create"
      }
    },
    {
      "input": {
        "entityType": "record",
        "entityId": "88888888-8888-4888-8888-888888888888",
        "changeType": "update"
      },
      "expected": {
        "entityType": "record",
        "entityId": "88888888-8888-4888-8888-888888888888",
        "changeType": "update"

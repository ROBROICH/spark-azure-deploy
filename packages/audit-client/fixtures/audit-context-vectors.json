      "X-Workflow-Type": "ActiveWorkflow",
      "X-Request-Starttime": "2026-07-16T09:01:00Z"
    },
    "explicit": {
      "X-Actor-User-Id": "55555555-5555-4555-8555-555555555555",
      "X-Workflow-Run-Id": "explicit-run"
    },
    "expected": {
      "X-Actor-User-Id": "55555555-5555-4555-8555-555555555555",
      "X-Triggered-By-User-Id": "22222222-2222-4222-8222-222222222222",
      "X-Workflow-Run-Id": "explicit-run",
      "X-Workflow-Type": "ActiveWorkflow",
      "X-Request-Starttime": "2026-07-16T09:01:00.000Z",
      "X-Request-Id": "33333333-3333-4333-8333-333333333333"
    }
  },
  "identity": {
    "sub": "66666666-6666-4666-8666-666666666666",
    "preferred_username": "reviewer",
    "realm_access": {
      "roles": ["user"]
    },
    "enabled": true,
    "expected": {
      "X-Actor-User-Id": "66666666-6666-4666-8666-666666666666"
    }
  },
  "changes": [
    {
      "input": {
        "entityType": "record",

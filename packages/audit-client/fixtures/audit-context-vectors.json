{
  "validHeaders": [
    {
      "name": "all six fields are normalized",
      "headers": {
        "X-Actor-User-Id": "AAAAAAAA-AAAA-4AAA-8AAA-AAAAAAAAAAAA",
        "X-Triggered-By-User-Id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
        "X-Workflow-Run-Id": "root-run/17",
        "X-Workflow-Type": "DocumentWorkflow",
        "X-Request-Starttime": "2026-07-16T08:15:30+00:00",
        "X-Request-Id": "CCCCCCCC-CCCC-4CCC-8CCC-CCCCCCCCCCCC"
      },
      "expected": {
        "X-Actor-User-Id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
        "X-Triggered-By-User-Id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
        "X-Workflow-Run-Id": "root-run/17",
        "X-Workflow-Type": "DocumentWorkflow",
        "X-Request-Starttime": "2026-07-16T08:15:30.000Z",
        "X-Request-Id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
      }
    },
    {
      "name": "epoch milliseconds are canonicalized",
      "headers": {
        "x-request-starttime": "1784189730123",
        "x-request-id": "dddddddd-dddd-4ddd-8ddd-dddddddddddd"
      },
      "expected": {
        "X-Request-Starttime": "2026-07-16T08:15:30.123Z",
        "X-Request-Id": "dddddddd-dddd-4ddd-8ddd-dddddddddddd"
      }
    }
  ],
  "malformedHeaders": [
    {
      "name": "bad UUIDs and time do not erase unrelated values",
      "headers": {
        "X-Actor-User-Id": "not-a-uuid",
        "X-Triggered-By-User-Id": "also-not-a-uuid",
        "X-Workflow-Run-Id": "run-still-valid",
        "X-Workflow-Type": "WorkerWorkflow",
        "X-Request-Starttime": "tomorrow-ish",
        "X-Request-Id": "request-not-a-uuid"
      },
      "expected": {
        "X-Workflow-Run-Id": "run-still-valid",
        "X-Workflow-Type": "WorkerWorkflow"
      }
    },
    {
      "name": "empty optionals are absent",
      "headers": {
        "X-Workflow-Run-Id": "   ",
        "X-Workflow-Type": "",
        "X-Request-Id": ""
      },
      "expected": {}
    }
  ],
  "precedence": {
    "forwarded": {
      "X-Actor-User-Id": "11111111-1111-4111-8111-111111111111",
      "X-Triggered-By-User-Id": "22222222-2222-4222-8222-222222222222",
      "X-Workflow-Run-Id": "forwarded-run",
      "X-Workflow-Type": "ForwardedWorkflow",
      "X-Request-Starttime": "2026-07-16T09:00:00Z",
      "X-Request-Id": "33333333-3333-4333-8333-333333333333"
    },
    "active": {
